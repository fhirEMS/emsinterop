        {"code": "9919001", "display": "Female", "target": [{"code": "female", "display": "Female", "equivalence": "equivalent"}]},
        {"code": "9919003", "display": "Male", "target": [{"code": "male", "display": "Male", "equivalence": "equivalent"}]},
        {"code": "9919005", "display": "Unknown", "target": [{"code": "unknown", "display": "Unknown", "equivalence": "equivalent"}]}
