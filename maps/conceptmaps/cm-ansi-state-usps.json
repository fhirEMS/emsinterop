  "url": "https://emsinterop.com/fhir/ConceptMap/cm-ansi-state-usps",
  "version": "0.1.0",
  "name": "AnsiStateToUspsAbbreviation",
  "title": "ANSI/FIPS state code -> USPS two-letter abbreviation",
  "status": "active",
  "experimental": false,
  "description": "NEMSIS stores a state as the two-digit ANSI/FIPS code (49); US Core binds Address.state to USPS two-letter abbreviations (UT). The two code sets are disjoint and in bijection, so this map is total and reversible \u2014 which is what lets a NEMSIS round trip stay exact. Writing the FIPS code into Address.state validates (the field is a string and the binding extensible) while being the wrong vocabulary, and a receiving system displays it verbatim.",
  "sourceUri": "https://nemsis.org/ValueSet/ANSIStateCode",
  "targetUri": "http://hl7.org/fhir/us/core/ValueSet/us-core-usps-state",
